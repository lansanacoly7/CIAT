# Copier ce fichier en .env et remplir les valeurs. Ne jamais publier .env sur Git.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Adresse publique du site, utilisée dans les QR codes (en production : l'adresse réelle)
SITE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Base de données. Vide = SQLite locale. En équipe : PostgreSQL.
# DATABASE_URL=postgres://ciat:ciat@localhost:5432/ciat

# Cache partagé (optionnel). Vide = LocMemCache local. En production multi-processus : Redis.
# REDIS_URL=redis://127.0.0.1:6379/1


# IA : ordre d'essai des fournisseurs. Si le premier échoue (quota), le suivant prend le relais.
AI_PROVIDERS=groq,gemini
# Clés gratuites : https://console.groq.com/keys et https://aistudio.google.com/apikey
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
